{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/forgemeshlabs/x402-verified/schema/partner.schema.json",
  "title": "Ecosystem partner record (curated by ForgeMesh)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "homepage", "description", "kind", "status", "added_at"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$" },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "description": { "type": "string", "minLength": 10, "maxLength": 200 },
    "kind": { "type": "string", "enum": ["network", "index", "directory", "tooling"] },
    "status": { "type": "string", "enum": ["live", "integration-pending"] },
    "status_note": { "type": "string", "maxLength": 140 },
    "added_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
