{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/forgemeshlabs/x402-verified/schema/seller.schema.json",
  "title": "x402 Verified seller record (human-edited)",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "slug", "homepage", "description", "protocols", "endpoints", "payTo", "networks", "contact", "proof", "added_at"],
  "properties": {
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$" },
    "homepage": { "type": "string", "format": "uri", "pattern": "^https://" },
    "description": { "type": "string", "minLength": 10, "maxLength": 140 },
    "protocols": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "enum": ["x402"] }
    },
    "endpoints": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "method", "price_usdc"],
        "properties": {
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "method": { "type": "string", "enum": ["GET", "POST"] },
          "price_usdc": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,6})?$" },
          "body": { "type": "object" }
        }
      }
    },
    "nominated_endpoint": { "type": "integer", "minimum": 0, "maximum": 4, "default": 0 },
    "payTo": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "networks": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "enum": ["eip155:8453"] }
    },
    "manifest": { "type": "string", "format": "uri", "pattern": "^https://" },
    "llms_txt": { "type": "string", "format": "uri", "pattern": "^https://" },
    "contact": { "type": "string", "pattern": "^(mailto:[^@\\s]+@[^@\\s]+|github:[A-Za-z0-9-]+)$" },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tx_hash", "endpoint", "payer_kind"],
      "properties": {
        "tx_hash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
        "endpoint": { "type": "integer", "minimum": 0, "maximum": 4 },
        "payer_kind": { "type": "string", "enum": ["self", "customer"], "description": "self = a wallet the seller operates paid; customer = an independent buyer paid" }
      }
    },
    "added_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}
